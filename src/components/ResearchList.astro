---
import AnimatedSection from './AnimatedSection';
import ResearchCard from './ResearchCard.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  items: CollectionEntry<'research'>[];
  activeTag?: string;
}

const { items, activeTag } = Astro.props;
---

<div class="min-h-screen w-full">
  <section class="py-20 w-full">
    <AnimatedSection client:load className="max-w-5xl mx-auto bg-white/40 dark:bg-gray-800/40 backdrop-blur-sm rounded-lg p-5 sm:p-8">
      <h1 class="font-heading text-3xl sm:text-4xl mb-6 text-primary-text">Research</h1>
      <p class="text-lg sm:text-xl text-gray-600 dark:text-gray-300 mb-8">
        Reports we have written, and work by others we have found worth reading.
      </p>

      {activeTag && (
        <p class="mb-8 text-gray-600 dark:text-gray-300">
          Showing reports tagged <span class="font-semibold text-primary-text">#{activeTag}</span>
          · <a href="/research/" class="text-primary-text hover:underline">show all</a>
        </p>
      )}

      <div class="grid gap-8">
        {items.map((item) => <ResearchCard item={item} activeTag={activeTag} />)}
      </div>
    </AnimatedSection>
  </section>
</div>
