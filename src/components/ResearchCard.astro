---
import type { CollectionEntry } from 'astro:content';

interface Props {
  item: CollectionEntry<'research'>;
  activeTag?: string;
}

const { item, activeTag } = Astro.props;
const { title, summary, url, image, imageAlt, tags, pubDate, source } = item.data;
const external = /^https?:\/\//.test(url);
const linkAttrs = external ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---

<article class="group grid sm:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] gap-6 bg-white/20 dark:bg-gray-900/20 rounded-lg p-4 sm:p-6 hover:bg-white/30 dark:hover:bg-gray-900/30 transition-colors">
  <a href={url} {...linkAttrs} class="block overflow-hidden rounded-md border border-gray-200 dark:border-gray-700 aspect-[16/9]" tabindex="-1" aria-hidden="true">
    <img
      src={image}
      alt={imageAlt}
      loading="lazy"
      class="w-full h-full object-cover object-top transition-transform duration-300 group-hover:scale-[1.03]"
    />
  </a>
  <div class="flex flex-col">
    <p class="text-xs text-gray-500 dark:text-gray-400 mb-2">
      {source} · {pubDate.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' })}
      {external && <span> · external</span>}
    </p>
    <h2 class="text-xl sm:text-2xl font-heading mb-3 leading-snug">
      <a href={url} {...linkAttrs} class="hover:text-primary-text transition-colors">{title}</a>
    </h2>
    <p class="text-gray-600 dark:text-gray-300">
      {summary}{' '}
      {tags.map((tag) => (
        <a
          href={`/research/tag/${tag}/`}
          class:list={[
            'font-semibold mr-2 hover:underline',
            tag === activeTag ? 'text-primary-dark underline' : 'text-primary-text',
          ]}
        >#{tag}</a>
      ))}
    </p>
  </div>
</article>
